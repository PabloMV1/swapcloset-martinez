digraph ER {
  graph [rankdir=LR, fontname="Helvetica", pad=0.4, nodesep=0.5, ranksep=1.1, bgcolor="white"];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#555555", arrowhead=crow, arrowtail=tee, dir=both];
  usuarios [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">username UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="2">email UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="3">password</TD></TR><TR><TD ALIGN="LEFT" PORT="4">fecha_nacimiento</TD></TR><TR><TD ALIGN="LEFT" PORT="5">ciudad</TD></TR><TR><TD ALIGN="LEFT" PORT="6">biografia</TD></TR><TR><TD ALIGN="LEFT" PORT="7">talla_camiseta / pantalon / calzado</TD></TR><TR><TD ALIGN="LEFT" PORT="8">rol</TD></TR><TR><TD ALIGN="LEFT" PORT="9">creado_en</TD></TR></TABLE>>];
  estilos [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>estilos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">nombre UQ</TD></TR></TABLE>>];
  usuarios_estilos [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>usuarios_estilos</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">usuario_id PK,FK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">estilo_id PK,FK</TD></TR></TABLE>>];
  categorias [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>categorias</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">nombre UQ</TD></TR></TABLE>>];
  prendas [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>prendas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">propietaria_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="2">categoria_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="3">estilo_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="4">titulo</TD></TR><TR><TD ALIGN="LEFT" PORT="5">descripcion</TD></TR><TR><TD ALIGN="LEFT" PORT="6">marca</TD></TR><TR><TD ALIGN="LEFT" PORT="7">talla</TD></TR><TR><TD ALIGN="LEFT" PORT="8">estado</TD></TR><TR><TD ALIGN="LEFT" PORT="9">modalidad</TD></TR><TR><TD ALIGN="LEFT" PORT="10">disponibilidad</TD></TR><TR><TD ALIGN="LEFT" PORT="11">activa</TD></TR><TR><TD ALIGN="LEFT" PORT="12">creada_en</TD></TR></TABLE>>];
  fotos_prenda [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>fotos_prenda</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">prenda_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="2">nombre_original</TD></TR><TR><TD ALIGN="LEFT" PORT="3">clave_disco UQ</TD></TR><TR><TD ALIGN="LEFT" PORT="4">tipo_contenido</TD></TR><TR><TD ALIGN="LEFT" PORT="5">tamano_bytes</TD></TR><TR><TD ALIGN="LEFT" PORT="6">orden (1-5)</TD></TR></TABLE>>];
  solicitudes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>solicitudes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">tipo</TD></TR><TR><TD ALIGN="LEFT" PORT="2">estado</TD></TR><TR><TD ALIGN="LEFT" PORT="3">prenda_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="4">solicitante_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="5">propietaria_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="6">prenda_ofrecida_id FK (opcional)</TD></TR><TR><TD ALIGN="LEFT" PORT="7">fecha_inicio / fecha_fin</TD></TR><TR><TD ALIGN="LEFT" PORT="8">creada_en</TD></TR></TABLE>>];
  mensajes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>mensajes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">solicitud_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="2">autor_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="3">texto</TD></TR><TR><TD ALIGN="LEFT" PORT="4">enviado_en</TD></TR></TABLE>>];
  valoraciones [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>valoraciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">solicitud_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="2">autor_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="3">valorado_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="4">puntuacion (1-5)</TD></TR><TR><TD ALIGN="LEFT" PORT="5">comentario</TD></TR><TR><TD ALIGN="LEFT" PORT="6">creada_en</TD></TR></TABLE>>];
  notificaciones [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#2b6cb0"><FONT COLOR="white"><B>notificaciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="0">id PK</TD></TR><TR><TD ALIGN="LEFT" PORT="1">usuario_id FK</TD></TR><TR><TD ALIGN="LEFT" PORT="2">tipo</TD></TR><TR><TD ALIGN="LEFT" PORT="3">mensaje</TD></TR><TR><TD ALIGN="LEFT" PORT="4">recurso</TD></TR><TR><TD ALIGN="LEFT" PORT="5">recurso_id</TD></TR><TR><TD ALIGN="LEFT" PORT="6">leida</TD></TR><TR><TD ALIGN="LEFT" PORT="7">creada_en</TD></TR></TABLE>>];
  usuarios -> usuarios_estilos [label="1:N"];
  estilos -> usuarios_estilos [label="1:N"];
  usuarios -> prendas [label="posee"];
  categorias -> prendas [label="clasifica"];
  estilos -> prendas [label="etiqueta"];
  prendas -> fotos_prenda [label="1 a 5 fotos"];
  prendas -> solicitudes [label="solicitada"];
  usuarios -> solicitudes [label="solicita / recibe"];
  solicitudes -> mensajes [label="chat"];
  usuarios -> mensajes [label="escribe"];
  solicitudes -> valoraciones [label="máx. 2"];
  usuarios -> valoraciones [label="da / recibe"];
  usuarios -> notificaciones [label="recibe"];
  prendas -> solicitudes [label="se ofrece (opcional)", style=dashed];
}
